# Copy to backend/.env locally. Never commit the populated .env file.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
LLM_PROVIDER=mock
# 실제 Gemini: LLM_PROVIDER=gemini 와 키를 서버에만 둔다 (프론트 .env에 넣지 않는다).
GEMINI_API_KEY=
# Qwen EXP-004 (Colab 추론 API): LLM_PROVIDER=qwen 을 명시했을 때만 사용한다 (auto는 선택하지 않음).
# 일반 채팅만 지원(임베딩·스트리밍·JSON 출력 없음). 키는 서버에만 둔다.
# QWEN_API_URL=https://your-tunnel.example.com   # HTTPS 또는 http://127.0.0.1:포트 만 허용
# QWEN_API_KEY=
# QWEN_TIMEOUT_SECONDS=120
# 하이브리드: Gemini 기본 + 냉장고 회장님 대사만 Qwen EXP-004 (기본 false). 켜려면 LLM_PROVIDER=gemini(또는 auto)와
# QWEN_API_URL/QWEN_API_KEY가 필요하다. Qwen이 실패하면 Gemini 원본 대사를 쓴다.
# FRIDGE_QWEN_DIALOGUE_ENABLED=false
# FRIDGE_QWEN_TIMEOUT_SECONDS=25
# FRIDGE_QWEN_MAX_TOKENS=200
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# GEMINI_THINKING_LEVEL=minimal  # 지원하는 모델에서만 지정
# 1회 제한 검증: GEMINI_HTTP_ATTEMPTS=1, STORY_GENERATION_ATTEMPTS=1
# 스토리만 검증할 때: LLM_PROBE_ON_STARTUP=false, SEED_ON_STARTUP=false
# STORY_RESPONSE_SCHEMA=false  # 모델이 responseJsonSchema를 거부(400)할 때만 끈다 (기본 true)
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Provision interactively: python -m scripts.create_admin --id YOUR_LOGIN_ID
# Optional first-start bootstrap: ADMIN_EMAIL + ADMIN_PASSWORD (12+ characters)
# Existing accounts are never silently reset by bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=
