# Copy to backend/.env locally. Never commit the populated .env file.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
LLM_PROVIDER=mock
# 실제 Gemini: LLM_PROVIDER=gemini 와 키를 서버에만 둔다 (프론트 .env에 넣지 않는다).
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# GEMINI_THINKING_LEVEL=minimal  # 지원하는 모델에서만 지정
# 1회 제한 검증: GEMINI_HTTP_ATTEMPTS=1, STORY_GENERATION_ATTEMPTS=1
# 스토리만 검증할 때: LLM_PROBE_ON_STARTUP=false, SEED_ON_STARTUP=false
# STORY_RESPONSE_SCHEMA=false  # 모델이 responseJsonSchema를 거부(400)할 때만 끈다 (기본 true)
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Provision interactively: python -m scripts.create_admin --email YOUR_EMAIL
# Optional first-start bootstrap: ADMIN_EMAIL + ADMIN_PASSWORD (12+ characters)
# Existing accounts are never silently reset by bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=
