# Copy to backend/.env locally. Never commit the populated .env file.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
LLM_PROVIDER=mock
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Provision interactively: python -m scripts.create_admin --email YOUR_EMAIL
# Optional first-start bootstrap: ADMIN_EMAIL + ADMIN_PASSWORD (12+ characters)
# Existing accounts are never silently reset by bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=
