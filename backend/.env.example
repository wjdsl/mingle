# Copy to backend/.env locally. Never commit the populated .env file.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
LLM_PROVIDER=mock
# 실제 Gemini: LLM_PROVIDER=gemini 와 키를 서버에만 둔다 (프론트 .env에 넣지 않는다).
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.5-flash
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Provision interactively: python -m scripts.create_admin --email YOUR_EMAIL
# Optional first-start bootstrap: ADMIN_EMAIL + ADMIN_PASSWORD (12+ characters)
# Existing accounts are never silently reset by bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=
