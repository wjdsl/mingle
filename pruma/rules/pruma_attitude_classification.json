{
  "schema_version": "1.1",
  "classification_id": "pruma_free_input_attitude_v1",
  "scope": "free_input_only",
  "description": "사용자의 자유 입력이 푸르마의 SOS나 대화에 대해 보이는 태도를 응원·도움, 중립, 퉁명·부정 중 하나로 분류한다. 문장 전체의 감정이 아니라 푸르마를 대하는 태도와 실제 도움 의도를 기준으로 한다.",
  "output": {
    "primary_attitude_field": "primary_attitude",
    "primary_attitude_enum": [
      "응원·도움",
      "중립",
      "퉁명·부정"
    ],
    "fallback_attitude": "중립"
  },
  "labels": [
    {
      "attitude": "응원·도움",
      "definition": "푸르마를 격려하거나, 같이 행동하자고 제안하거나, 구체적인 정보·방법·대안을 제공하는 등 실제로 도우려는 의도가 분명한 입력",
      "positive_cues": [
        "같이 하자",
        "내가 도와줄게",
        "찾아보자",
        "가보자",
        "해보자",
        "괜찮아",
        "할 수 있어",
        "힘내",
        "걱정 마",
        "이렇게 해",
        "여기로 가",
        "다른 방법을 찾아보자",
        "내가 알려줄게"
      ],
      "examples": [
        "괜찮아, 같이 찾아보자",
        "내가 데려다줄게",
        "도서관으로 가보는 게 어때?",
        "잘할 수 있어. 일단 계획부터 세워보자"
      ],
      "caveats": [
        "단순 긍정 감탄만 있고 도움 의도가 없으면 중립 가능",
        "욕설·혐오·위기 신호는 태도보다 안전 규칙이 우선"
      ]
    },
    {
      "attitude": "중립",
      "definition": "도움·격려나 거절·무시가 뚜렷하지 않은 일반 답변, 질문, 사실 전달, 자기 상태 표현, 애매한 짧은 응답",
      "positive_cues": [
        "응",
        "그래",
        "음",
        "왜?",
        "모르겠어",
        "잘 모르겠는데",
        "피곤해",
        "시험 싫다",
        "할 수 있을까",
        "그런가?"
      ],
      "examples": [
        "음... 잘 모르겠어",
        "시험은 진짜 싫다",
        "그게 가능할까?",
        "오늘은 좀 피곤해"
      ],
      "caveats": [
        "구체적인 도움·격려가 있으면 응원·도움",
        "푸르마를 명확히 거절·무시하면 퉁명·부정"
      ]
    },
    {
      "attitude": "퉁명·부정",
      "definition": "푸르마의 요청을 명확히 귀찮아하거나 거절하고, 무시하거나 내치는 태도가 핵심인 입력. 단순히 상황이나 시험을 싫어하는 감정은 여기에 포함하지 않는다.",
      "positive_cues": [
        "알아서 해",
        "너 혼자 해",
        "귀찮아",
        "싫어",
        "왜 나한테 물어봐",
        "상관없어",
        "나한테 묻지 마",
        "도와주기 싫어",
        "네가 알아서 해"
      ],
      "examples": [
        "귀찮아, 너 혼자 해",
        "왜 나한테 물어봐? 알아서 해",
        "난 도와주기 싫어",
        "상관없어. 네가 알아서 해"
      ],
      "caveats": [
        "거절 표현 뒤에 실제 대안이나 도움을 제공하면 전체 의도는 응원·도움일 수 있음",
        "부정 감정의 대상이 시험·상황·학교 등이고 푸르마를 향하지 않으면 중립"
      ]
    }
  ],
  "decision_rules": [
    {
      "order": 1,
      "rule": "fixed_choice_bypass",
      "description": "고정 선택지 버튼은 태도 분류를 하지 않는다. 선택지의 친밀도 변화는 pruma_rules.json의 choice_button 규칙을 따른다."
    },
    {
      "order": 2,
      "rule": "safety_precedes_attitude",
      "description": "위기 신호, 욕설·혐오, 개인정보 등 안전 규칙 대상이면 안전 응답을 먼저 적용한다. 해당 입력의 태도 분류 결과를 보상 계산에 쓰지 않을 수 있다."
    },
    {
      "order": 3,
      "rule": "judge_attitude_toward_pruma",
      "description": "문장 전체의 감정이 아니라 푸르마의 SOS·질문·대화에 대해 사용자가 어떤 태도를 보이는지 판정한다."
    },
    {
      "order": 4,
      "rule": "helpful_action_over_negative_context",
      "description": "시험·학교·상황에 대한 부정 표현이 있어도 푸르마에게 구체적인 도움이나 격려를 제공하면 응원·도움으로 분류한다."
    },
    {
      "order": 5,
      "rule": "clear_rejection_required_for_negative",
      "description": "퉁명·부정은 푸르마를 향한 거절·무시·귀찮아함이 명확할 때만 사용한다. 단순한 짧은 답변이나 '모르겠어'만으로는 부정으로 올리지 않는다."
    },
    {
      "order": 6,
      "rule": "alternative_help_counts_as_helpful",
      "description": "한 행동을 거절하더라도 다른 방법·정보·대안을 제시해 실제 도움 의도가 남아 있으면 응원·도움으로 본다."
    },
    {
      "order": 7,
      "rule": "one_primary_attitude",
      "description": "한 자유 입력에는 친밀도 계산용 primary_attitude를 하나만 부여한다."
    },
    {
      "order": 8,
      "rule": "ambiguous_fallback",
      "description": "태도가 불분명하거나 문맥이 부족하면 중립으로 처리한다."
    }
  ],
  "integration": {
    "affinity_gain_rule_ref": "pruma_rules.gain.attitude",
    "affinity_cap_rule_ref": "pruma_rules.limits.affinity_per_turn",
    "safety_rule_ref": "pruma_profile.safety_responses"
  }
}
